use v6.c;
use Test;
use Arithmetic::PaperAndPencil;

plan(36);

my Arithmetic::PaperAndPencil $operation .= new;
my Arithmetic::PaperAndPencil::Number $result;
my Arithmetic::PaperAndPencil::Number $x   .= new(radix => 10, value => '9212');
my Arithmetic::PaperAndPencil::Number $one .= new(radix => 10, value => '1');
$result = $operation.division(dividend => $x, divisor => $one);

my $fh  = open('xt/data/24-step1.csv' , :w);
my $fhh = open('xt/data/24-step1.html', :w);
my $fhl = open('xt/data/24-step1.tex' , :w);

dies-ok(  { $operation.csv(filehandle => $fh, pathname => 'xt/data/24-step2.csv') }, "use of both 'filehandle' and 'pathname' parameters");
dies-ok(  { $operation.csv(filehandle => $fh, pathname => 'xt/data/24-step2.csv', filemode => 'a') }, "use of both 'filehandle' and 'pathname' parameters");
dies-ok(  { $operation.csv(filehandle => $fh, filemode => 'a') }, "use of parameter 'filemode' without parameter 'pathname'");
dies-ok(  { $operation.csv(filemode => 'a') }, "use of parameter 'filemode' without parameter 'pathname'");
lives-ok( { $operation.csv(pathname => 'xt/data/24-step2.csv', filemode => 'a' ) }, "use of parameter 'filemode' with parameter 'pathname' = 'a'");
lives-ok( { $operation.csv(pathname => 'xt/data/24-step2.csv', filemode => 'w' ) }, "use of parameter 'filemode' with parameter 'pathname' = 'w'");
lives-ok( { $operation.csv(pathname => 'xt/data/24-step2.csv', filemode => '>' ) }, "use of parameter 'filemode' with parameter 'pathname' = '>'");
lives-ok( { $operation.csv(pathname => 'xt/data/24-step2.csv', filemode => '>>') }, "use of parameter 'filemode' with parameter 'pathname' = '>>'");
dies-ok(  { $operation.csv(pathname => 'xt/data/24-step2.csv', filemode => 'b' ) }, "wrong parameter 'filemode'");
lives-ok( { $operation.csv() }, "no parameters at all");
lives-ok( { $operation.csv(filehandle => $fh) }, "single parameter 'filehandle'");
lives-ok( { $operation.csv(pathname   => 'xt/data/24-step2.csv') }, "single parameter 'pathname'");

dies-ok(  { $operation.html(lang => 'fr', level => 3, filehandle => $fhh, pathname => 'xt/data/24-step2.html') }, "use of both 'filehandle' and 'pathname' parameters in method 'html'");
dies-ok(  { $operation.html(lang => 'fr', level => 3, filehandle => $fhh, pathname => 'xt/data/24-step2.html', filemode => 'a') }, "use of both 'filehandle' and 'pathname' parameters in method 'html'");
dies-ok(  { $operation.html(lang => 'fr', level => 3, filehandle => $fhh, filemode => 'a') }, "use of parameter 'filemode' without parameter 'pathname' in method 'html'");
dies-ok(  { $operation.html(lang => 'fr', level => 3, filemode => 'a') }, "use of parameter 'filemode' without parameter 'pathname' in method 'html'");
lives-ok( { $operation.html(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.html', filemode => 'a' ) }, "use of parameter 'pathname' with parameter 'filemode' = 'a' in method 'html'");
lives-ok( { $operation.html(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.html', filemode => 'w' ) }, "use of parameter 'pathname' with parameter 'filemode' = 'w' in method 'html'");
lives-ok( { $operation.html(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.html', filemode => '>' ) }, "use of parameter 'pathname' with parameter 'filemode' = '>' in method 'html'");
lives-ok( { $operation.html(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.html', filemode => '>>') }, "use of parameter 'pathname' with parameter 'filemode' = '>>' in method 'html'");
dies-ok(  { $operation.html(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.html', filemode => 'b' ) }, "wrong parameter 'filemode' in method 'html'");
lives-ok( { $operation.html(lang => 'fr', level => 3  ) }, "no parameters at all in method 'html'");
lives-ok( { $operation.html(lang => 'fr', level => 3, filehandle => $fhh) }, "single parameter 'filehandle' in method 'html'");
lives-ok( { $operation.html(lang => 'fr', level => 3, pathname   => 'xt/data/24-step2.html') }, "single parameter 'pathname' in method 'html'");

dies-ok(  { $operation.latex(lang => 'fr', level => 3, filehandle => $fhl, pathname => 'xt/data/24-step2.tex') }, "use of both 'filehandle' and 'pathname' parameters in method 'latex'");
dies-ok(  { $operation.latex(lang => 'fr', level => 3, filehandle => $fhl, pathname => 'xt/data/24-step2.tex', filemode => 'a') }, "use of both 'filehandle' and 'pathname' parameters in method 'latex'");
dies-ok(  { $operation.latex(lang => 'fr', level => 3, filehandle => $fhl, filemode => 'a') }, "use of parameter 'filemode' without parameter 'pathname' in method 'latex'");
dies-ok(  { $operation.latex(lang => 'fr', level => 3, filemode => 'a') }, "use of parameter 'filemode' without parameter 'pathname' in method 'latex'");
lives-ok( { $operation.latex(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.tex', filemode => 'a' ) }, "use of parameter 'pathname' with parameter 'filemode' = 'a' in method 'latex'");
lives-ok( { $operation.latex(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.tex', filemode => 'w' ) }, "use of parameter 'pathname' with parameter 'filemode' = 'w' in method 'latex'");
lives-ok( { $operation.latex(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.tex', filemode => '>' ) }, "use of parameter 'pathname' with parameter 'filemode' = '>' in method 'latex'");
lives-ok( { $operation.latex(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.tex', filemode => '>>') }, "use of parameter 'pathname' with parameter 'filemode' = '>>' in method 'latex'");
dies-ok(  { $operation.latex(lang => 'fr', level => 3, pathname => 'xt/data/24-step2.tex', filemode => 'b' ) }, "wrong parameter 'filemode' in method 'latex'");
lives-ok( { $operation.latex(lang => 'fr', level => 3  ) }, "no parameters at all in method 'latex'");
lives-ok( { $operation.latex(lang => 'fr', level => 3, filehandle => $fhl) }, "single parameter 'filehandle' in method 'latex'");
lives-ok( { $operation.latex(lang => 'fr', level => 3, pathname   => 'xt/data/24-step2.tex') }, "single parameter 'pathname' in method 'latex'");

$fh.close;
$fhh.close;
$fhl.close;
